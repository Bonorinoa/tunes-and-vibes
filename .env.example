# Copy to .env and fill. Never commit .env.
# Redirect URI registered on the Spotify app: http://127.0.0.1:8888/callback

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Garmin: email only here. Password + MFA are entered once via garth login.
GARMIN_EMAIL=

# Telegram bot token from @BotFather (channel wiring is deferred).
TELEGRAM_BOT_TOKEN=
